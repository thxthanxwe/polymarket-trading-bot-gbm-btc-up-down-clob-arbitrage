# ─── Mode ───────────────────────────────────────────────────────────────────
PAPER_MODE=true

# ─── Live trading (required when PAPER_MODE=false) ──────────────────────────
PRIVATE_KEY=
FUNDER_ADDRESS=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# ─── Strategy ─────────────────────────────────────────────────────────────
MIN_EDGE=0.03
KELLY_FRACTION=0.25
MAX_TRADE_USD=50
MAX_POSITION_PER_MARKET_USD=100
MAX_LOSS_PER_DAY_USD=200
ENABLED_TIMEFRAMES=5m,15m,1h
STOP_BUYING_BEFORE_CLOSE_SEC=90

# ─── Costs model ───────────────────────────────────────────────────────────
FEE_RATE=0.02
HALF_SPREAD_BUFFER=0.01
SLIPPAGE_BUFFER=0.005

# ─── Volatility ─────────────────────────────────────────────────────────────
EWMA_LAMBDA=0.94
VOLATILITY_WINDOW_SEC=3600
DEFAULT_SIGMA=0.60

# ─── Optional drift (0 = risk-neutral short horizon) ───────────────────────
DRIFT_MU=0

# ─── APIs ───────────────────────────────────────────────────────────────────
GAMMA_API_URL=https://gamma-api.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
LOG_LEVEL=info
LOG_DIR=./logs
