# Registry
registry=${REGISTRY}

# TLS
strict-ssl=true

# Fetch behavior (npm defaults, set explicitly)
fetch-retries=2
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000

# Install / lockfile
package-lock=true
save-exact=false
legacy-peer-deps=false
fund=true
audit=true
prefer-online=false
engine-strict=false
